# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Jupyter checkpoints
.ipynb_checkpoints/

# Data – raw/processed files are large; track only .gitkeep placeholders
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/datasets/*
!data/datasets/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Reports / generated plots
reports/*
!reports/.gitkeep

# Trained model artefacts
src/models/*.joblib
src/models/model.joblib
src/models/scaler.joblib

# OS artefacts
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
saved_models/*.pkl